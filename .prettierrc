{
  "printWidth": 100,
  "bracketSpacing": true,
  "jsxBracketSameLine": false,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "es5",
  "plugins": ["prettier-plugin-css-order"],
  "cssOrder": {
    "order": [
      "position",
      "top",
      "right",
      "bottom",
      "left",
      "z-index",
      "display",
      "flex",
      "grid",
      "gap",
      "width",
      "height",
      "margin",
      "padding",
      "border",
      "border-radius",
      "background",
      "color",
      "font-size",
      "font-weight",
      "line-height",
      "text-align",
      "opacity",
      "transition",
      "transform",
      "animation"
    ]
  }
}
